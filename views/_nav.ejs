<nav>
  <a href="/" class="<%= page == '/' ? 'active' : '' %>"> Camera Preview </a>
  <a href="/logs" class="<%= page == '/logs' ? 'active' : '' %>">API Logs</a>
  <a
    href="/transactions"
    class="<%= page == '/transactions' ? 'active' : '' %>"
  >
    Transaction Logs
  </a>

  <button
    class="btn btn-warning"
    style="margin: 0 10px"
    type="button"
    onclick="reconnectListener()"
  >
    <span
      id="listener-status"
      style="
        background-color: green;
        margin-right: 5px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
      "
    ></span>
    Reconnect Listener
  </button>

  <span
    id="time"
    style="font-size: 16px; color: yellow; margin-left: 10px"
  ></span>
</nav>

<script>
  function updateTime() {
    const now = new Date();
    const timeString = now.toLocaleTimeString("id-ID");
    document.getElementById("time").textContent = timeString;
  }

  setInterval(updateTime, 1000);
  updateTime();

  function reconnectListener() {
    fetch("/reconnect-listener", { method: "POST" })
      .then((res) => res.json())
      .then((data) => {
        if (data.success) {
          alert("Listener reconnected successfully");
        } else {
          alert("Failed to reconnect listener");
        }
      })
      .catch((err) => {
        console.error(err);
        alert("Error reconnecting listener");
      });
  }

  function updateListenerStatus() {
    fetch("/listener-status")
      .then((res) => res.json())
      .then((data) => {
        const statusElement = document.getElementById("listener-status");
        if (data.success) {
          statusElement.style.backgroundColor = "green";
        } else {
          statusElement.style.backgroundColor = "red";
        }
      })
      .catch((err) => {
        console.error(err);
        document.getElementById("listener-status").style.backgroundColor =
          "red";
      });
  }

  setInterval(updateListenerStatus, 5000);
  updateListenerStatus();
</script>
