<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Logs</title>
    <link rel="stylesheet" href="/style.css" />

    <style>
      .status {
        border: 1px solid;
        padding: 5px 10px;
        border-radius: 4px;
        width: 120px;
        text-align: center;
      }

      .success {
        border-color: green;
        color: green;
      }

      .failed {
        border-color: red;
        color: red;
      }

      .pending {
        border-color: gray;
        color: gray;
      }

      .error {
        padding: 15px;
        border: 1px solid red;
        border-radius: 4px;
        color: red;
        font-weight: bold;
        background-color: rgb(241, 185, 185);
      }

      pre {
        background-color: black;
        color: white;
        padding: 10px;
        border-radius: 4px;
      }
    </style>
  </head>
  <body>
    <%- include('_nav' , { page: '/logs'}) %>

    <div class="container-fluid">
        <div style="flex-grow: 1; display: flex; flex-direction: column; gap: 15px;">
          <% if (error) { %>
           <div class="error"><%= error.message %></div>
          <% } %>

          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;"">
            <form style="display: flex; gap: 10px; align-items: center;">
              <input type="text" name="keyword" placeholder="Search" value="<%= keyword %>"  />
              <input type="date" name="from" value="<%= from?.split(' ')[0] %>" />
              <div> - </div>
              <input type="date" name="to" value="<%= to?.split(' ')[0] %>" />
              <button class="btn btn-primary">🔍 Search</button>
              <button class="btn btn-primary" type="button" id="btn-export">📑 Export</button>
              <button class="btn btn-primary" type="reset" onclick="refreshData()">Refresh</button>
            </form>

            <div style="display: flex; gap: 5px; align-items: center;">
              <span style="margin-right: 10px;">
                <span id="data-from"><%= dataFrom %></span> - <span id="data-to"><%= dataTo %></span> of <span id="total"><%= total %></span>
              </span>
              <button id="prev-btn" class="btn" onclick="goToPrev()" <%= !prevPage ? 'disabled' : '' %>>&laquo; Prev</button>
              <button id="next-btn" class="btn" onclick="goToNext()" <%= !nextPage ? 'disabled' : '' %>>Next &raquo;</button>
            </div>
          </div>

          <div style="max-height: calc(100vh - 160px); overflow-y: auto;">
            <table class="striped-table">
              <thead>
                <tr>
                  <th>Time In</th>
                  <th>Gate</th>
                  <th>Driver Name</th>
                  <th>Driver ID</th>
                  <th style="text-align: center;">API Response Status</th>
                </tr>
              </thead>
              <tbody id="table-data">
                <% rows.forEach(r => { %>
                  <tr onclick="showDetail('<%= r.id %>')">
                    <td><%= r.Time.toLocaleString('id-ID') %></td>
                    <td><%= r.Gate %></td>
                    <td><%= r["Driver Name"] %></td>
                    <td><%= r["Driver ID"] %></td>
                    <td style="text-align: center;">
                      <span class="status <%= r.status === true ? 'success' : r.status === false ? 'failed' : 'pending' %>">
                        <%= r.status === true ? 'Success' : r.status === false ? 'Failed' : 'Pending' %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
                
              </tbody>
            </table>
          </div>
        </div>

        <dialog id="my-dialog">
        <div class="dialog-header">
          <div> API Log Detail </div>
          <button class="btn btn-circle" commandfor="my-dialog" command="close">X</button>
        </div>
        <div class="dialog-body">

          <img 
            id="snapshot" 
            src="" 
            alt="Snapshot" 
            style="width: 100%; padding: 5px; border: 1px solid #ddd; border-radius: 4px; margin-bottom: 15px;transform: scaleX(-1);" 
          />

          <table class="striped-table">
            <tbody>
              <tr>
                <td style="font-weight: bold;">Log ID</td>
                <td id="log_id"></td>
              </tr>
              <tr>
                <td style="font-weight: bold;">Time In</td>
                <td id="time"></td>
              </tr>
              <tr>
                <td style="font-weight: bold;">Gate</td>
                <td id="gate"></td>
              </tr>
              <tr>
                <td style="font-weight: bold;">Driver Name</td>
                <td id="driver_name"></td>
              </tr>
              <tr>
                <td style="font-weight: bold;">Driver ID</td>
                <td id="driver_id"></td>
              </tr>
              <tr>
                <td style="font-weight: bold;">API Response Status</td>
                <td id="response_status"></td>
              </tr>
            </tbody>
          </table>

          <div style="font-weight: bold;">
            API Response:
          </div>
          <pre id="api_response"></pre>

          <div style="font-weight: bold;">
            API Payload:
          </div>
          <pre id="api_payload"></pre>

          <div style="font-weight: bold;">
            Raw Log:
          </div>
          <pre id="raw_log"></pre>
        </div>
      </dialog>
    </div>

    <%- include('_loading') %>

    <script src="/script.js"></script>

    <script>
      path = 'logs';

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        page = 1;
        fetchData();
      });

      // handle export button
      const exportBtn = document.querySelector('#btn-export');
      exportBtn.addEventListener('click', (e) => {
        e.preventDefault();
        exportToExcel();
      });

      async function showDetail(id) {
        setLoading(true);

        try {
          const res = await fetch(`/logs/${id}`)
          const data = await res.json();

          if (res.status == 404) {
            throw new Error("Log not found")
          }

          if (res.status == 500) {
            throw new Error("Internal server error")
          }

          if (res.status == 200) {
            const logIdEl = document.querySelector('#log_id');
            const timeEl = document.querySelector('#time');
            const gateEl = document.querySelector('#gate');
            const snapshotEl = document.querySelector('#snapshot');
            const driverIdEl = document.querySelector('#driver_id');
            const driverNameEl = document.querySelector('#driver_name');
            const apiResponseEl = document.querySelector('#api_response');
            const responseStatusEl = document.querySelector('#response_status');
            const rawLogEl = document.querySelector('#raw_log');
            const apiPayloadEl = document.querySelector('#api_payload');

            logIdEl.innerHTML = data.log_id;
            timeEl.innerHTML = data.time;
            gateEl.innerHTML = data.device_id;
            snapshotEl.setAttribute('src', data.snapshotUrl)
            driverIdEl.innerHTML = data.driver_id;
            driverNameEl.innerHTML = data.driver_name;
            apiResponseEl.innerHTML = JSON.stringify(data.api_response, null, 2);
            responseStatusEl.innerHTML = data.response_status;
            rawLogEl.innerHTML = JSON.stringify(data.raw_log, null, 2);
            apiPayloadEl.innerHTML = JSON.stringify(data.api_payload, null, 2);

            const dialog = document.querySelector('dialog');
            dialog.showModal();
          }
        } catch (error) {
          console.error(error.message)
        }

        setLoading(false);
      }
    </script>
  </body>
</html>
