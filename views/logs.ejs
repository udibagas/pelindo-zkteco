<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Logs</title>
    <link rel="stylesheet" href="/style.css" />

    <style>
      .status {
        border: 1px solid;
        padding: 5px 10px;
        border-radius: 4px;
        width: 120px;
        text-align: center;
      }

      .success {
        border-color: green;
        color: green;
      }

      .failed {
        border-color: red;
        color: red;
      }

      .pending {
        border-color: gray;
        color: gray;
      }

      .error {
        padding: 15px;
        border: 1px solid red;
        border-radius: 4px;
        color: red;
        font-weight: bold;
        background-color: rgb(241, 185, 185);
      }

      pre {
        background-color: black;
        color: white;
        padding: 10px;
        border-radius: 4px;
      }
    </style>
  </head>
  <body>
    <%- include('_nav' , { page: '/logs'}) %>

    <div class="container-fluid">
        <div style="flex-grow: 1; display: flex; flex-direction: column; gap: 15px;">
          <% if (err) { %>
           <div class="error"><%= err.message %></div>
          <% } %>

          <div style="display: flex; justify-content: space-between; align-items: center;">
            <form style="display: flex; gap: 10px; align-items: center;">
              <input type="text" name="keyword" placeholder="Search" value="<%= keyword %>"  />
              <input type="date" name="from" value="<%= from?.split(' ')[0] %>" />
              <div>
                -
              </div>
              <input type="date" name="to" value="<%= to?.split(' ')[0] %>" />
              <button class="btn btn-primary">🔍 Search</button>
              <button class="btn btn-primary" name="action" value="export">📑 Export</button>
              <a class="btn btn-primary" href="/logs">Refresh</a>
            </form>

            <div style="display: flex; gap: 5px; align-items: center;">
              <span style="margin-right: 10px;">
                <%= dataFrom %> - <%= dataTo %> of <%= total %>
              </span>
              <button class="btn" onclick="goToPage('<%= prevPage %>')" <%= !prevPage ? 'disabled' : '' %>>&laquo; Prev</button>
              <button class="btn" onclick="goToPage('<%= nextPage %>')" <%= !nextPage ? 'disabled' : '' %>>Next &raquo;</button>
            </div>
          </div>

          

          <div style="max-height: calc(100vh - 160px); overflow-y: auto;">
            <table class="striped-table">
              <thead>
                <tr>
                  <th>Time In</th>
                  <th>Gate</th>
                  <th>Driver Name</th>
                  <th>Driver ID</th>
                  <th style="text-align: center;">API Response Status</th>
                </tr>
              </thead>
              <tbody>
                <% rows.forEach(r => { %>
                  <tr onclick="showDetail('<%= r.id %>')">
                    <td><%= r.time.toLocaleString('id-ID') %></td>
                    <td><%= r.device_id %></td>
                    <td><%= r.driver_name %></td>
                    <td><%= r.driver_id %></td>
                    <td style="text-align: center;">
                      <span class="status <%= r.response_status === true ? 'success' : r.response_status === false ? 'failed' : 'pending' %>">
                        <%= r.response_status === true ? 'Success' : r.response_status === false ? 'Failed' : 'Pending' %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
                
              </tbody>
            </table>
          </div>
        </div>

        <dialog id="my-dialog">
        <div class="dialog-header">
          <div> API Log Detail </div>
          <button class="btn btn-circle" commandfor="my-dialog" command="close">X</button>
        </div>
        <div class="dialog-body">
          <table class="striped-table">
            <thead>
              <tr>
                <th style="width: 200px">Parameter</th>
                <th>Value</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="font-weight: bold;">Log ID</td>
                <td id="log_id"></td>
              </tr>
              <tr>
                <td style="font-weight: bold;">Time In</td>
                <td id="time"></td>
              </tr>
              <tr>
                <td style="font-weight: bold;">Driver Name</td>
                <td id="driver_name"></td>
              </tr>
              <tr>
                <td style="font-weight: bold;">Driver ID</td>
                <td id="driver_id"></td>
              </tr>
              <tr>
                <td style="font-weight: bold;">API Response Status</td>
                <td id="response_status"></td>
              </tr>
              <tr>
                <td style="font-weight: bold;">API Response</td>
                <td>
                  <pre id="api_response"></pre>
                </td>
              </tr>
              <tr>
                <td style="font-weight: bold;">Raw Log</td>
                <td>
                  <pre id="raw_log"></pre>
                </td>
              </tr>
              <tr>
                <td style="font-weight: bold;">API Payload</td>
                <td>
                  <pre id="api_payload"></pre>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </dialog>

        
    </div>

    <script>
      async function showDetail(id) {
        try {
          const res = await fetch(`/logs/${id}`)
          const data = await res.json();

          if (res.status == 404) {
            throw new Error("Log not found")
          }

          if (res.status == 500) {
            throw new Error("Internal server error")
          }

          if (res.status == 200) {
            const logIdEl = document.querySelector('#log_id');
            const timeEl = document.querySelector('#time');
            const driverIdEl = document.querySelector('#driver_id');
            const driverNameEl = document.querySelector('#driver_name');
            const apiResponseEl = document.querySelector('#api_response');
            const responseStatusEl = document.querySelector('#response_status');
            const rawLogEl = document.querySelector('#raw_log');
            const apiPayloadEl = document.querySelector('#api_payload');

            logIdEl.innerHTML = data.log_id;
            timeEl.innerHTML = data.time;
            driverIdEl.innerHTML = data.driver_id;
            driverNameEl.innerHTML = data.driver_name;
            apiResponseEl.innerHTML = JSON.stringify(data.api_response, null, 2);
            responseStatusEl.innerHTML = data.response_status;
            rawLogEl.innerHTML = JSON.stringify(data.raw_log, null, 2);
            apiPayloadEl.innerHTML = JSON.stringify(data.api_payload, null, 2);

            const dialog = document.querySelector('dialog');
            dialog.showModal();
          }
        } catch (error) {
          console.error(error.message)
        }
      }

      function goToPage(page) {
        const params = new URLSearchParams(window.location.search);
        const pageSize = params.get('pageSize') || 100;
        const keyword = params.get('keyword') || '';
        const from = params.get('from') || '';
        const to = params.get('to') || '';

        const queryString = new URLSearchParams({
          page,
          pageSize,
          keyword,
          from,
          to
        }).toString()

        window.location.href = `/logs?${queryString}`;
      }
    </script>
  </body>
</html>
