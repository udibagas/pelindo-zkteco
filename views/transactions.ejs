<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Transaction Logs</title>
    <link rel="stylesheet" href="/style.css" />

    <style>
      .error {
        padding: 15px;
        border: 1px solid red;
        border-radius: 4px;
        color: red;
        font-weight: bold;
        background-color: rgb(241, 185, 185);
      }

      pre {
        width: 100%;
        background-color: black;
        color: white;
        padding: 10px;
        border-radius: 4px;
        overflow-x: auto;
      }
    </style>
  </head>
  <body>
    <%- include('_nav' , { page: '/transactions'}) %>

    <div class="container-fluid">
      <div style="flex-grow: 1; display: flex; flex-direction: column; gap: 15px;">
        <% if (err) { %>
          <div class="error"><%= err.message %></div>
        <% } %>

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
          <form style="display: flex; gap: 10px; align-items: center;">
            <input type="text" name="keyword" placeholder="Search" value="<%= keyword %>"  />
            <input type="date" name="from" value="<%= from?.split(' ')[0] %>" />
            <div>
              -
            </div>
            <input type="date" name="to" value="<%= to?.split(' ')[0] %>" />
            <button class="btn btn-primary">🔍 Search</button>
            <button class="btn btn-primary" name="action" value="export">📑 Export</button>
            <button class="btn btn-primary" onclick="refreshData()">Refresh</button>
          </form>

          <div style="display: flex; gap: 5px; align-items: center;">
            <span style="margin-right: 10px;">
              <span id="data-from"><%= dataFrom %></span> - <span id="data-to"><%= dataTo %></span> of <span id="total"><%= total %></span>
            </span>
            <button id="prev-btn" class="btn" onclick="goToPrev()" <%= !prevPage ? 'disabled' : '' %>>&laquo; Prev</button>
            <button id="next-btn" class="btn" onclick="goToNext()" <%= !nextPage ? 'disabled' : '' %>>Next &raquo;</button>
          </div>
        </div>

        <div style="max-height: calc(100vh - 160px); overflow-y: auto;">
          <table class="striped-table">
            <thead>
              <tr>
                <th>Time In</th>
                <th>Gate</th>
                <th>Driver Name</th>
                <th>Driver ID</th>
              </tr>
            </thead>
            <tbody id="table-data">
              <% rows.forEach(r => { %>
                <tr onclick="showDetail('<%= r.id %>')">
                  <td><%= r.event_time.toLocaleString('id-ID') %></td>
                  <td><%= r.dev_alias %></td>
                  <td><%= r.name %></td>
                  <td><%= r.pin %></td>
                </tr>
              <% }) %>
              
            </tbody>
          </table>
        </div>
      </div>

      <dialog id="my-dialog">
        <div class="dialog-header">
          <div> Transaction Log Detail </div>
          <button class="btn btn-circle" commandfor="my-dialog" command="close">X</button>
        </div>
        <div class="dialog-body">
          <pre id="detail">No Data selected</pre>
          
        </div>
      </dialog>
    </div>
    
    <div id="loading-overlay">Loading...</div>
    <script>
      const formEl = document.querySelector('form');

      formEl.addEventListener('submit', (e) => {
        e.preventDefault();
        const formData = new FormData(formEl);
        const params = Object.fromEntries(formData);
        fetchData(params);
      });

      async function showDetail(id) {
        const dialog = document.querySelector('dialog');
        const detailEl = document.querySelector('#detail');
        if (!detailEl) return;

        const res = await fetch(`/transactions/${id}`, {
          headers: {
            'Content-Type': 'application/json'
          }
        });

        const data = await res.json();
        detailEl.innerHTML = JSON.stringify(data, null, 2);
        dialog.showModal();
      }

      function refreshData() {
        fetchData({ page: 1, keyword: '', from: '', to: ''})
      }

      function goToNext() {
        const params = new URLSearchParams(window.location.search);
        let page = params.get('page') || 1;
        if (isNaN(+page)) page = 1;
        fetchData({ page: Number(page) + 1})
      }

      function goToPrev() {
        const params = new URLSearchParams(window.location.search);
        let page = params.get('page') || 1;
        if (isNaN(+page)) page = 1;
        fetchData({ page: Number(page) - 1})
      }

      async function fetchData(detaultParams = {}) {
        // block ui
        const loadingEl = document.querySelector('#loading-overlay');
        loadingEl.style.display = 'flex';

        // get params from url
        const params = new URLSearchParams(window.location.search);
        const paramsObj = Object.fromEntries(params);
        const queryString = new URLSearchParams({...paramsObj, ...detaultParams}).toString()
        const url = `/transactions?${queryString}`;

        const response = await fetch(url, {
          headers: {
            "Content-Type": "application/json"
          }
        });

        if (response.status == 200) {
          const { rows, nextPage, prevPage, total, dataFrom, dataTo  } = await response.json();
          
          // update table data
          const tableDataEl = document.querySelector('#table-data');
          const tableDataContent = [];

          for (const r of rows) {
            tableDataContent.push(`
              <tr onclick="showDetail('${r.id}')">
                <td>${r.event_time.toLocaleString('id-ID')}</td>
                <td>${r.dev_alias}</td>
                <td>${r.name}</td>
                <td>${r.pin}</td>
              </tr>
            `)
          }

          tableDataEl.innerHTML = tableDataContent.join("\n");

          // Update count
          const dataFromEl = document.querySelector('#data-from');
          const dataToEl = document.querySelector('#data-to');
          const totalEl = document.querySelector('#total');

          dataFromEl.innerHTML = dataFrom;
          dataToEl.innerHTML = dataTo;
          totalEl.innerHTML = total;

          // Update button state
          const prevBtn = document.querySelector('#prev-btn');
          const nextBtn = document.querySelector('#next-btn');

          if (!nextPage) {
            nextBtn.setAttribute('disabled', '');
          } else {
            nextBtn.removeAttribute('disabled')
          }

          if (!prevPage) {
            prevBtn.setAttribute('disabled', '');
          } else {
            prevBtn.removeAttribute('disabled')
          }

          history.pushState(null, '', url);
        }

        loadingEl.style.display = 'none';
      }
    </script>
  </body>
</html>
